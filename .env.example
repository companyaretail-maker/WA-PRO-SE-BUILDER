# GEMINI_API_KEY: Required for the procedural assistant (/api/chat).
# Without it the assistant endpoint returns 503 instead of failing open.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The origin this app is served from. Used to lock CORS to that origin.
# If unset, CORS falls back to reflecting any origin -- set this in production.
APP_URL="MY_APP_URL"

# PAYPAL_CLIENT_ID: PayPal REST app client ID. Read SERVER-SIDE and handed to the
# browser via /api/config. Do NOT use a VITE_ prefixed variable for this: a
# build-time value cannot be rotated without a rebuild, and the server needs the
# same ID it authenticates with.
PAYPAL_CLIENT_ID="YOUR_PAYPAL_CLIENT_ID"

# PAYPAL_CLIENT_SECRET: PayPal REST app secret. Never prefix with VITE_.
PAYPAL_CLIENT_SECRET="YOUR_PAYPAL_CLIENT_SECRET"

# PAYPAL_MODE: "sandbox" (default) or "live". Payments are processed against the
# sandbox API until this is set to live.
PAYPAL_MODE="sandbox"

# PAYPAL_WEBHOOK_ID: Registered webhook ID from the PayPal dashboard. Required --
# /api/paypal-webhook rejects every delivery it cannot verify against this ID.
PAYPAL_WEBHOOK_ID="YOUR_PAYPAL_WEBHOOK_ID"

# SESSION_SECRET: HMAC key for signing purchase (entitlement) tokens. If unset, a
# random key is generated per process and every purchase token stops working on
# restart. Set a long random value in production.
SESSION_SECRET="YOUR_SESSION_SECRET"
